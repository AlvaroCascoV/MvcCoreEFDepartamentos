@model IEnumerable<MvcCoreEFDepartamentos.Models.Departamento>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.deptNo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.dNombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.localidad)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.deptNo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.dNombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.localidad)
            </td>
            <td>
                    @Html.ActionLink("Edit", "Edit", new { item.deptNo }) |
                    @Html.ActionLink("Details", "Details", new { item.deptNo }) |
                    @Html.ActionLink("Delete", "Delete", new { item.deptNo })
            </td>
        </tr>
}
    </tbody>
</table>
